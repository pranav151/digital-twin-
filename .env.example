# Copy to .env and adjust. docker-compose and the services read these.
# cp .env.example .env

# --- MQTT (Mosquitto) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Live data source (build plan Part 6) ---
# Where the backend gets live data. Passive sources publish to MQTT on their own
# (the backend just consumes the bus); the connector sources are launched in-process.
#   emulator   - run edge/emulator separately (default; also: simulated|external|hardware)
#   opcua      - subscribe to an OPC-UA server and republish to MQTT
#   mtconnect  - poll an MTConnect agent and republish to MQTT
DATA_SOURCE=emulator
CONNECTOR_LINE_ID=L1

# OPC-UA connector (DATA_SOURCE=opcua). Defaults to the Eclipse Milo public demo.
OPCUA_ENDPOINT=opc.tcp://milo.digitalpetri.com:62541/milo
# Map OPC-UA NodeIds to (station_id, field). field: state|cycle_time_s|part_count|current_a|part_present
# OPCUA_NODE_MAP={"ns=2;i=1001":["S1","state"],"ns=2;i=1002":["S1","cycle_time_s"]}

# MTConnect connector (DATA_SOURCE=mtconnect). Defaults to the public demo agent.
MTCONNECT_URL=https://demo.mtconnect.org
MTCONNECT_POLL_S=2.0
# Map MTConnect device names (GET {agent}/probe) to your stations.
# MTCONNECT_DEVICE_MAP={"OKUMA":"S15","Mazak":"S16"}

# EXTRA_SOURCES: pull from MULTIPLE public manufacturing endpoints at once (each its
# own in-process connector). JSON list of {"type":"mtconnect"|"opcua","url":...,
# "device_map"|"node_map":{...},"poll":2.0}. Example adds Mazak's REAL iSmart factory:
# EXTRA_SOURCES=[{"type":"mtconnect","url":"http://mtconnect.mazakcorp.com:5610","device_map":{"MFMS10-MC2":"S17"}}]

# Modbus TCP connector (DATA_SOURCE=modbus). Point at a PLC / Factory I/O / soft-PLC.
MODBUS_HOST=localhost
MODBUS_PORT=502
MODBUS_POLL_S=1.0
# Per-station holding-register addresses. Fields: state, part_count, current_x100, spindle_rpm.
# MODBUS_REGISTER_MAP={"S1":{"unit":1,"state":0,"part_count":1,"current_x100":2}}

# --- InfluxDB 2.x ---
# These seed the InfluxDB container on first boot AND are read by the services.
INFLUX_USERNAME=admin
INFLUX_PASSWORD=factorytwin
INFLUX_URL=http://localhost:8086
INFLUX_ORG=factory
INFLUX_BUCKET=telemetry
# Change this before anything real. Must match the token services use.
INFLUX_TOKEN=dev-token-change-me
